# Long file names on the SD card
CONFIG_FATFS_LFN_HEAP=y
# 1 ms tick for responsive polling
CONFIG_FREERTOS_HZ=1000
# Console + FATFS + mbedTLS need more than the default 1 MB app partition
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# Task watchdog: a CPU starved by a stuck task triggers a reset
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_PANIC=y
# The I2C bus uses the legacy driver (works on all ESP-IDF 5.x versions)
CONFIG_I2C_SUPPRESS_DEPRECATE_WARN=y
